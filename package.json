{
  "name": "virallink",
  "version": "1.0.0",
  "private": true,
  "description": "Virallink — public company website and internal management platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @virallink/api",
    "dev:web": "npm run dev --workspace @virallink/web",
    "build": "npm run build --workspace @virallink/api && npm run build --workspace @virallink/web",
    "build:api": "npm run build --workspace @virallink/api",
    "build:web": "npm run build --workspace @virallink/web",
    "start:api": "npm run start --workspace @virallink/api",
    "start:web": "npm run start --workspace @virallink/web",
    "migrate": "npm run migrate --workspace @virallink/api",
    "migrate:status": "npm run migrate:status --workspace @virallink/api",
    "migrate:undo": "npm run migrate:undo --workspace @virallink/api",
    "seed": "npm run seed --workspace @virallink/api",
    "seed:demo": "npm run seed:demo --workspace @virallink/api",
    "backup": "npm run backup --workspace @virallink/api",
    "lint": "npm run lint --workspace @virallink/web && npm run lint --workspace @virallink/api",
    "test": "npm run test --workspace @virallink/api"
  },
  "devDependencies": {
    "concurrently": "9.1.2"
  }
}