# ==========================================================================
# Virallink — environment configuration
#
# Copy to .env and fill in real values. NEVER commit a real .env.
# On cPanel, these can instead be set in the "Environment Variables" section
# of each Setup Node.js App, or placed in the app root as a .env file.
#
# The API validates every variable at boot (apps/api/src/config/env.js) and
# refuses to start with a named error if one is missing or malformed.
# ==========================================================================


# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Bind to loopback on shared hosting: Passenger proxies to 127.0.0.1 and the
# database must never be reachable from the internet. On a VPS you would set
# 0.0.0.0 and let Nginx proxy instead.
API_HOST=127.0.0.1

# Public site origin. Used for CORS allowlist and canonical URLs.
# IMPORTANT: no trailing slash.
SITE_URL=http://localhost:3000


# --------------------------------------------------------------------------
# MySQL
# --------------------------------------------------------------------------
# On cPanel the database is created in phpMyAdmin / "MySQL Databases" and the
# user is granted only those privileges. Use the host cPanel assigns, which is
# usually "localhost", NOT "127.0.0.1" — MySQL treats them as different accounts
# and a 127.0.0.1 connection can be refused even when localhost is allowed.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=virallink
DB_USER=virallink_user
DB_PASSWORD=
DB_DIALECT=mysql

# Connection pool. Keep this small: cPanel enforces a per-process memory limit
# and kills processes that exceed it, and most shared plans cap concurrent
# MySQL connections per user.
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# Local development only. When true, the API runs sequelize.sync({ alter: true })
# on every start, so tables follow the models and no migration is needed while
# building. ALWAYS false in production — config/env.js refuses to boot if this
# is true when NODE_ENV=production, because alter:true can drop columns and
# destroy data. Production applies schema changes with `npm run migrate`.
DB_SYNC_ALLOWED=false
DB_LOG_QUERIES=false


# --------------------------------------------------------------------------
# Authentication
# --------------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
# There are two distinct secrets on purpose. If a refresh token ever leaks you
# can rotate REFRESH_SECRET without invalidating every active admin session.
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie settings. COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_PATH=/

# Bcrypt cost. 12 is a sensible balance on shared hosting; raise to 13 if the
# host has CPU headroom.
BCRYPT_ROUNDS=12

# Max failed logins before temporary lockout for one account/email pair.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15


# --------------------------------------------------------------------------
# CORS — comma-separated allowlist of origins permitted to call the API.
# The admin app calls the API from the browser, so the site origin must be here.
# --------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000


# --------------------------------------------------------------------------
# Rate limiting (in-memory; no Redis on cPanel)
# --------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CONTACT_MAX=5


# --------------------------------------------------------------------------
# Media storage
# --------------------------------------------------------------------------
# driver=local writes files to MEDIA_ROOT.
# driver=s3 writes to any S3-compatible object store. Switching drivers is one
# variable change; the code path is identical.
STORAGE_DRIVER=local

# Local disk. Keep this OUTSIDE public_html and serve it through the media
# route so uploads cannot execute code.
#   local dev: D:/virallink/storage/media
#   cPanel:    /home/CPANELUSER/storage/media
MEDIA_ROOT=./storage/media
MEDIA_PUBLIC_URL=/media

# Maximum upload size in bytes. cPanel's PHP/file limits may be lower, so this
# is a ceiling, not a guarantee.
MEDIA_MAX_BYTES=10485760

# Allowed upload MIME types. Images only by default.
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif,image/gif

# S3-compatible storage (used only when STORAGE_DRIVER=s3)
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=


# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
# pino levels: trace debug info warn error fatal
LOG_LEVEL=info
# Pretty console output in development only; production emits JSON for cPanel logs.
LOG_PRETTY=false


# --------------------------------------------------------------------------
# Maintenance
# --------------------------------------------------------------------------
# Days of activity_log to retain. Pruned by the cron job.
ACTIVITY_RETENTION_DAYS=365

# Where `npm run backup` writes SQL dumps.
BACKUP_DIR=./storage/backups
BACKUP_RETENTION_COUNT=14


# ==========================================================================
# NEXT.JS (apps/web) — only NEXT_PUBLIC_* values reach the browser
# ==========================================================================
# Browser-facing. Safe to expose, contains no secrets.
# Public website: leave API_PUBLIC_URL empty and the app calls its own route
# handlers instead, which avoids CORS entirely in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_PUBLIC_URL=

# Server-side only. Use 127.0.0.1 on cPanel so app-to-app calls never leave
# the server, and never hard-code the externally visible URL here.
API_INTERNAL_URL=http://127.0.0.1:4000

# Where the admin's access/refresh cookies are written by the route handlers.
NEXT_PUBLIC_ADMIN_PATH=/admin-teftef