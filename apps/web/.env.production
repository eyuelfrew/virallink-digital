# Production build values for the Next.js web app.
# Next.js loads this file for `next build` and `next start`. It contains only
# public URLs (no secrets), so it is safe to commit. These NEXT_PUBLIC_* values
# are inlined into the bundle at build time - never build with localhost here.

NEXT_PUBLIC_SITE_URL=https://virallinkdigital.com
NEXT_PUBLIC_API_PUBLIC_URL=https://api.virallinkdigital.com
API_INTERNAL_URL=https://api.virallinkdigital.com
NEXT_PUBLIC_ADMIN_PATH=/vira-admin
