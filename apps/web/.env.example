# Frontend (Next.js web app) environment.
# Copy to .env in this directory and fill in real values. NEVER commit a real .env.
# The web app is independent of the API: it needs the site's public origin and
# where the API is reachable from server-side. A .env here is loaded by Next.js
# automatically at build/dev time; production reads it via the cPanel
# Environment Variables UI or a .env in this app's root.

NODE_ENV=development

# Public site origin. Browser-facing; safe to expose. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-facing API origin. Every browser-side call goes straight here — it
# shows up in the Network tab as a request to this origin; there is no Next.js
# route handler in the middle. The API must allow this site's origin in
# CORS_ORIGINS and set cookies on the shared parent domain.
# Production: https://api.virallinkdigital.com
# Local dev:  http://localhost:4000  (put this in .env.local, which is gitignored)
# NEXT_PUBLIC_* is baked in at build time, so set it before `next build`.
NEXT_PUBLIC_API_PUBLIC_URL=https://api.virallinkdigital.com

# Server-side only. Where the web app reaches the API.
# Local dev: the API listens on loopback, so 127.0.0.1 / localhost works.
# When the API is deployed at its own origin, e.g. https://api.virallinkdigital.com,
# set it to that URL — the web app then calls it over the public internet.
API_INTERNAL_URL=http://127.0.0.1:4000

# Where the admin's access/refresh cookies are written by the route handlers.
NEXT_PUBLIC_ADMIN_PATH=/vira-admin
