# Backend (Express API) environment.
# Copy to .env in this directory and fill in real values. NEVER commit a real .env.
# The API validates every variable at boot (src/config/env.js) and refuses to
# start if one is missing or malformed. AUTO_MIGRATE/AUTO_SEED are on by
# default: a fresh clone applies the schema and RBAC seed on first boot.

# Application
NODE_ENV=development
PORT=4000
API_HOST=127.0.0.1
# Public site origin (no trailing slash). Required: the API serves public
# media URLs (Telegram, sitemap) built from this.
SITE_URL=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=virallink
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_SYNC_ALLOWED=false
DB_LOG_QUERIES=false
AUTO_MIGRATE=true
AUTO_SEED=true
TEST_DB_NAME=virallink_test

# Authentication (generate: openssl rand -base64 48)
JWT_SECRET=change-me-at-least-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters-long-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false
# Session cookies. COOKIE_DOMAIN should be the registrable parent of the API's
# origin — virallinkdigital.com when the API is at api.virallinkdigital.com —
# so the web app, which reads the session cookie from its own origin, sees it.
COOKIE_DOMAIN=virallinkdigital.com
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# CORS — comma-separated allowlist of origins permitted to call the API. When
# the browser calls the API directly, the site's origin must be listed here.
CORS_ORIGINS=http://localhost:3000,https://virallinkdigital.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_PASSWORD_RESET_MAX=20

# Media storage. Relative MEDIA_ROOT resolves from the API app root, so the
# default ./uploads keeps files inside the backend directory (outside the web
# app's public_html). Set an absolute path if you want them elsewhere.
STORAGE_DRIVER=local
MEDIA_ROOT=./uploads
MEDIA_PUBLIC_URL=/media
MEDIA_MAX_BYTES=10485760

# Aggregate auto-reply analytics (counts only; no message text is stored).
TELEGRAM_ANALYTICS_RETENTION_DAYS=180
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
ACTIVITY_RETENTION_DAYS=365
BACKUP_DIR=./storage/backups

# Telegram bot (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ANNOUNCE_CHAT_ID=
TELEGRAM_LINK_CODE_TTL_MINUTES=30
TELEGRAM_API_TIMEOUT_MS=30000
# Optional dedicated key for encrypting Telegram tokens / personal-account sessions.
TELEGRAM_AUTO_REPLY_KEY=

# Firebase Cloud Messaging (push notifications). Either FIREBASE_SERVICE_ACCOUNT
# (JSON inline) or FIREBASE_SERVICE_ACCOUNT_PATH. Optional; push disabled when unset.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
